<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RobloxDroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rd_black</item>
        <item name="android:colorBackground">@color/rd_black</item>
        <item name="android:statusBarColor">@color/rd_black</item>
        <item name="android:navigationBarColor">@color/rd_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorPrimary">@color/rd_primary</item>
        <item name="colorOnPrimary">@color/rd_on_primary</item>
        <item name="colorPrimaryContainer">@color/rd_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rd_on_primary_container</item>
        <item name="colorSecondary">@color/rd_secondary</item>
        <item name="colorOnSecondary">@color/rd_on_secondary</item>
        <item name="colorSecondaryContainer">@color/rd_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/rd_on_secondary_container</item>
        <item name="colorSurface">@color/rd_surface</item>
        <item name="colorSurfaceVariant">@color/rd_surface_container</item>
        <item name="colorOnSurface">@color/rd_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/rd_on_surface_variant</item>
        <item name="colorOutline">@color/rd_outline</item>
        <item name="colorError">@color/rd_error</item>
        <item name="colorOnError">@color/rd_on_error</item>

        <item name="android:fontFamily">sans</item>
        <item name="sliderStyle">@style/Widget.RobloxDroid.Slider</item>
    </style>

    <style name="Widget.RobloxDroid.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">24dp</item>
        <item name="tickVisibilityMode">hidden</item>
    </style>
</resources>
