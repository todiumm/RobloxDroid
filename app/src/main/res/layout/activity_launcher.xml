<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/launcher_logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="RobloxDroid"
        android:src="@drawable/logo_robloxdroid"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/launcher_status"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:textSize="13sp"
        android:text="Verificando componentes…" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_play"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:text="Abrir Roblox Studio"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_install"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Instalar componentes" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Configurações"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart" />

</LinearLayout>
